{
  "name": "@ltodorov/primes",
  "version": "2.0.1",
  "description": "Utility functions for working with prime numbers",
  "keywords": [
    "javascript",
    "nodejs",
    "prime numbers",
    "typescript"
  ],
  "homepage": "https://github.com/ltodorov/primes",
  "bugs": {
    "url": "https://github.com/ltodorov/primes/issues"
  },
  "license": "MIT",
  "author": "Lyubomir Todorov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltodorov/primes.git"
  },
  "bin": "./index.js",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "clean": "pnpm run /^clean:.+/",
    "clean:build": "rimraf ./dist",
    "clean:test": "rimraf ./coverage",
    "build": "pnpm clean:build && tsc",
    "lint": "pnpm oxlint",
    "lint:fix": "pnpm oxlint --fix",
    "format": "pnpm oxfmt --check",
    "format:fix": "pnpm oxfmt",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/input": "^5.1.5",
    "@inquirer/select": "^5.2.4",
    "@ltodorov/primes": "link:"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.3.12",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "chalk": "^6.0.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4"
}
