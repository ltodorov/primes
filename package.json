{
  "name": "@ltodorov/primes",
  "version": "2.0.1",
  "description": "Utility functions for working with prime numbers",
  "keywords": [
    "javascript",
    "nodejs",
    "prime numbers",
    "typescript"
  ],
  "homepage": "https://github.com/ltodorov/primes",
  "bugs": {
    "url": "https://github.com/ltodorov/primes/issues"
  },
  "license": "MIT",
  "author": "Lyubomir Todorov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltodorov/primes.git"
  },
  "bin": "./index.js",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "clean": "pnpm run /^clean:.+/",
    "clean:build": "rimraf ./dist",
    "clean:test": "rimraf ./coverage",
    "build": "pnpm clean:build && tsc",
    "lint": "pnpm oxlint",
    "lint:fix": "pnpm oxlint --fix",
    "format": "pnpm oxfmt --check",
    "format:fix": "pnpm oxfmt",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/input": "^5.2.0",
    "@inquirer/select": "^5.3.0"
  },
  "devDependencies": {
    "@inquirer/testing": "^3.4.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "chalk": "^6.0.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
